{
  "name": "neuratube",
  "version": "0.11.1",
  "private": true,
  "description": "AI-native YouTube optimizer. Bring your own API key.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "node build/build.mjs",
    "dev": "node build/build.mjs --watch",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "compile": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "icons": "node scripts/gen-icons.mjs",
    "size": "node build/sizes.mjs",
    "zip": "node build/zip.mjs",
    "verify": "pnpm run compile && pnpm run lint && pnpm run format:check && pnpm run test && pnpm run build && pnpm run size"
  },
  "dependencies": {
    "@preact/signals": "^2.0.1",
    "preact": "^10.27.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@playwright/test": "^1.56.0",
    "@preact/preset-vite": "^2.10.1",
    "@types/chrome": "^0.1.29",
    "@types/node": "^22.15.0",
    "axe-core": "^4.13.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.37.0",
    "globals": "^16.4.0",
    "happy-dom": "^20.0.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "author": "Akalanka Ekanayake (https://github.com/Akalanka1337)",
  "repository": {
    "type": "git",
    "url": "https://github.com/Akalanka1337/neuratube.git"
  },
  "homepage": "https://github.com/Akalanka1337/neuratube",
  "bugs": {
    "url": "https://github.com/Akalanka1337/neuratube/issues"
  }
}
